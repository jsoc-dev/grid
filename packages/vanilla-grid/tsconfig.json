{
  "compilerOptions": {
    // language
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "jsx-dom",

    "rootDir": "./src",
    "allowImportingTsExtensions": true, // subpath imports require file extensions

    // type checking
    "skipLibCheck": true,
    "strict": true,
    "strictNullChecks": true,
    "strictFunctionTypes": true,
    "noUnusedLocals": true,

    // output
    "noEmit": true // bundler will be used to emit
  },

  "include": ["src"]
}
