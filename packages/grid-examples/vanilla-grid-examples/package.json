{
  "name": "@jsoc/vanilla-grid-examples",
  "version": "0.0.1",
  "description": "Shared utilities for JSOC Grid vanilla documentation examples.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsoc-dev/grid.git",
    "directory": "packages/grid-examples/vanilla-grid-examples"
  },
  "bugs": {
    "url": "https://github.com/jsoc-dev/grid/issues"
  },
  "homepage": "https://github.com/jsoc-dev/grid/tree/main/packages/grid-examples/vanilla-grid-examples#readme",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "types": "./dist/index.d.mts"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm -w build-packages",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jsoc/grid-docs": "workspace:*",
    "@jsoc/grid-examples-core": "workspace:*",
    "@jsoc/utils": "workspace:*",
    "jsx-dom": "^8.1.6"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
