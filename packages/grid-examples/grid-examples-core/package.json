{
  "name": "@jsoc/grid-examples-core",
  "version": "0.0.1",
  "description": "Core utilities for JSOC Grid documentation examples across frameworks.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jsoc-dev/grid.git",
    "directory": "packages/grid-examples/grid-examples-core"
  },
  "bugs": {
    "url": "https://github.com/jsoc-dev/grid/issues"
  },
  "homepage": "https://github.com/jsoc-dev/grid/tree/main/packages/grid-examples/grid-examples-core#readme",
  "type": "module",
  "imports": {
    "#*": "./src/*"
  },
  "exports": {
    ".": "./src/index.ts",
    "./css/*": "./src/css/*"
  },
  "publishConfig": {
    "main": "./dist/index.mjs",
    "module": "./dist/index.mjs",
    "types": "./dist/index.d.mts",
    "exports": {
      ".": {
        "import": "./dist/index.mjs",
        "types": "./dist/index.d.mts"
      },
      "./css/*": "./src/css/*"
    }
  },
  "files": [
    "dist",
    "src/css"
  ],
  "scripts": {
    "build": "pnpm -w build-packages",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jsoc/grid-docs": "workspace:*",
    "@jsoc/utils": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
