{
  "$schema": "https://json.schemastore.org/chrome-manifest.json",
  "manifest_version": 3,
  "name": "JSON Preview",
  "version": "0.0.1",
  "description": "Preview JSON documents as a table in the browser",
  "action": {
    "default_title": "JSON Preview"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_end"
    }
  ]
}
